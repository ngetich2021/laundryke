// Prisma schema — Turso (libSQL) via driver adapter at runtime.
// Local migrations run against DATABASE_URL (file:./dev.db); apply the
// generated SQL to Turso with `turso db shell <db-name> < migration.sql`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PermissionKey {
  MANAGE_USERS
  MANAGE_LISTINGS
  MANAGE_PAYMENTS
  MANAGE_PRICING
  MANAGE_ROLES
  MANAGE_SUPPORT
}

enum ReferralRewardType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageAuthorRole {
  USER
  ADMIN
  AI
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  COMPLIMENT
  OTHER
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                  String    @id @default(nanoid(10))
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  phone               String?
  locationDescription String?
  role                Role      @default(USER)
  customRoleId        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  listings       Listing[]
  payments       Payment[]
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
  feedback       Feedback[]
  chatMessages   ChatMessage[]
  customRole     CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
}

model CustomRole {
  id        String   @id @default(nanoid(10))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id         String        @id @default(nanoid(10))
  roleId     String
  permission PermissionKey

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model Account {
  id                String  @id @default(nanoid(10))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(nanoid(10))
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id                 String       @id @default(nanoid(10))
  ownerId            String
  businessName       String
  description        String
  phone              String?
  address            String?
  latitude           Float?
  longitude          Float?
  videoSource        VideoSource?
  videoUrl           String?
  imageUrl           String?
  tiktokUrl          String?
  facebookUrl        String?
  instagramUrl       String?
  isActive           Boolean      @default(true)
  promotedUntil      DateTime?
  videoPromotedUntil DateTime?
  referralRewardType  ReferralRewardType?
  referralRewardValue Int?
  referralDescription String?
  referralClickCount  Int         @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  priceItems      PriceItem[]
  clients         Client[]
  visits          Visit[]
  loyaltyProgram  LoyaltyProgram?
  campaignTargets CampaignTarget[]

  @@index([ownerId])
  @@index([isActive, createdAt])
  @@index([isActive, promotedUntil])
  @@index([isActive, videoPromotedUntil])
}

model PriceItem {
  id        String   @id @default(nanoid(10))
  listingId String
  label     String
  priceKes  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Payment {
  id                String        @id @default(nanoid(10))
  listingId         String
  userId            String
  amount            Int
  phone             String
  days              Int
  includesVideo     Boolean       @default(false)
  status            PaymentStatus @default(PENDING)
  merchantRequestId String?
  checkoutRequestId String?       @unique
  mpesaReceipt      String?
  resultDesc        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
}

model SupportTicket {
  id        String       @id @default(nanoid(10))
  userId    String
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status, createdAt])
}

model SupportMessage {
  id         String            @id @default(nanoid(10))
  ticketId   String
  authorId   String?
  authorRole MessageAuthorRole
  body       String
  createdAt  DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model Feedback {
  id        String           @id @default(nanoid(10))
  userId    String
  rating    Int
  category  FeedbackCategory @default(OTHER)
  message   String
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(nanoid(10))
  userId    String?
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model HealthCheckLog {
  id        String   @id @default(nanoid(10))
  status    String
  report    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Client {
  id                 String   @id @default(nanoid(10))
  listingId          String
  name               String
  phone              String?
  email              String?
  notes              String?
  loyaltyPunches     Int      @default(0)
  loyaltyRedemptions Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visits  Visit[]

  @@index([listingId])
}

model Visit {
  id        String   @id @default(nanoid(10))
  clientId  String
  listingId String
  amountKes Int?
  notes     String?
  visitedAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([listingId, visitedAt])
}

model LoyaltyProgram {
  id                String   @id @default(nanoid(10))
  listingId         String   @unique
  punchesRequired   Int
  rewardDescription String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

enum CampaignMetric {
  NEW_CLIENTS
  VISITS
  REVENUE_KES
  CUSTOM
}

model CampaignTarget {
  id          String         @id @default(nanoid(10))
  listingId   String
  title       String
  metric      CampaignMetric
  targetValue Int
  manualValue Int            @default(0)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}
